# SMTP configuration for the contact form (/api/contact)
# Copy this file to .env.local and fill in your real values.

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=contact@kotelek.dev
SMTP_PASS=your-smtp-password

# Where contact form submissions are delivered.
CONTACT_TO=contact@kotelek.dev

# The authenticated "from" address (defaults to SMTP_USER if omitted).
CONTACT_FROM=contact@kotelek.dev
